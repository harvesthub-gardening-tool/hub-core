[build]
target = "xtensa-esp32s3-espidf"

[target.'cfg(target_os = "espidf")']
linker = "ldproxy"
runner = "espflash flash --monitor"
rustflags = [ "--cfg",  "espidf_time64"]

[unstable]
build-std = ["std", "panic_abort"]

[env]
MCU = "esp32s3"
ESP_IDF_VERSION = "v5.5.3"
ESP_IDF_TOOLS_INSTALL_DIR = "workspace"
ESP_IDF_PATH_ISSUES = "warn"

# Uncomment this if you have moved the target dir by setting CARGO_TARGET_DIR or similar.
# Required for now due to embuild limitations.
#CARGO_WORKSPACE_DIR = { value = "", relative = true }

API_URL = "http://harvest-hub-api.grimmely.com"

# Optional dev override: bypass first-boot QR/AssociateHub/ClaimHubToken flow by
# pre-seeding NVS with a hub JWT minted directly against the backend. Leave
# unset for production; in production the hub generates its own device_id and
# hub_secret on first boot, prints them to serial as a QR payload, and exchanges
# them for a JWT via auth.v2.ClaimHubToken after the user calls AssociateHub.
# HUB_TOKEN = "paste-dev-only-hub-jwt-here"
